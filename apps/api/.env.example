NODE_ENV=development
API_PORT=3001
APP_ORIGIN=http://localhost:5173
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/unloss?schema=public
SESSION_SECRET=replace-with-at-least-32-random-characters
DEMO_MODE=false
# Set DEMO_MODE=true only for local demo seeding and explicitly labelled test OTPs.
# This checkpoint binds to 127.0.0.1 and blocks NODE_ENV=production while security phases remain open.
SEED_SELLER_EMAIL=demo@unloss.local
SEED_SELLER_PASSWORD=replace-with-a-local-demo-password
QR_TOKEN_TTL_DAYS=90
