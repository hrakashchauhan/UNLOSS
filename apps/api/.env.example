NODE_ENV=development
API_PORT=3001
APP_ORIGIN=http://127.0.0.1:5173
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/unloss?schema=public
SESSION_SECRET=replace-with-at-least-32-random-characters
DEMO_MODE=false
# Set DEMO_MODE=true only for local demo seeding and explicitly labelled test OTPs.
# Cloud serving requires all three settings plus an HTTPS APP_ORIGIN.
API_HOST=127.0.0.1
TRUST_PROXY_HOPS=0
PRODUCTION_ENABLED=false
# Set GOOGLE_CLIENT_ID to the web OAuth client ID to enable verified Google login.
# GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
SEED_SELLER_EMAIL=demo@unloss.local
SEED_SELLER_PASSWORD=replace-with-a-local-demo-password
# Optional synthetic created/dispatched/returned orders; reruns preserve existing records.
SEED_SAMPLE_ORDERS=false
QR_TOKEN_TTL_DAYS=90
