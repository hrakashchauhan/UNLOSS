generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Shared identity and role memberships
// ---------------------------------------------------------------------------

model User {
  id           String   @id @default(cuid())
  name         String
  email        String?  @unique
  googleSubject String? @unique
  phone        String?  @unique
  passwordHash String?
  status       String   @default("ACTIVE")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  seller           Seller?
  memberships      RoleMembership[]
  customerProfile  CustomerProfile?
  deliveryProfile  DeliveryProfile?
  adminPermissions AdminPermission[]

  notifications    AppNotification[]
  payoutAccount    PayoutAccount?
  claims           ParcelClaim[]       @relation("ClaimDeliveryUser")
  claimDecisions   ParcelClaim[]       @relation("ClaimDecisionMaker")
  locations        LocationEvidence[]
  earnings         DeliveryEarning[]
  auditLogs        AuditLog[]
  customerOrders   Order[]             @relation("CustomerUser")
  sessions         Session[]

  @@index([status])
}

model RoleMembership {
  id        String   @id @default(cuid())
  userId    String
  role      String
  status    String   @default("ACTIVE")
  grantedAt DateTime @default(now())
  grantedBy String?
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, role])
  @@index([role, status])
}

model CustomerProfile {
  id            String   @id @default(cuid())
  userId        String   @unique
  defaultName   String?
  addressLine1  String?
  addressLine2  String?
  city          String?
  state         String?
  postalCode    String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model DeliveryProfile {
  id               String    @id @default(cuid())
  userId           String    @unique
  employer         String
  deliveryReference String
  reviewStatus     String    @default("PENDING")
  reviewedBy       String?
  reviewedAt       DateTime?
  rejectionReason  String?
  phoneVerifiedAt  DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([reviewStatus])
}

model AdminPermission {
  id         String   @id @default(cuid())
  userId     String
  permission String
  grantedAt  DateTime @default(now())
  grantedBy  String?
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, permission])
}

model AuthOtpChallenge {
  id                    String    @id @default(cuid())
  phone                 String
  codeHash              String
  purpose               String    @default("LOGIN")
  attempts              Int       @default(0)
  expiresAt             DateTime
  consumedAt            DateTime?
  verifiedAt            DateTime?
  verificationHash      String?
  verificationExpiresAt DateTime?
  createdAt             DateTime  @default(now())

  @@index([phone, createdAt])
  @@index([expiresAt])
}

// ---------------------------------------------------------------------------
// Existing seller account, preserved for credential compatibility
// ---------------------------------------------------------------------------

model Seller {
  id            String         @id @default(cuid())
  email         String         @unique
  passwordHash  String
  name          String
  userId        String?        @unique
  createdAt     DateTime       @default(now())
  user          User?          @relation(fields: [userId], references: [id])
  orders        Order[]
  sessions      Session[]
  ledger        LedgerEntry[]
  notifications Notification[]
  products      Product[]
  drafts        OrderDraft[]
  funding       FundingAccount?
  fundingTxns   FundingTransaction[]
  reservations  BudgetReservation[]
  earnings      DeliveryEarning[]
}

model Session {
  sid       String   @id
  sellerId  String?
  userId    String?
  data      Json
  expiresAt DateTime
  seller    Seller?  @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
  @@index([userId])
}

model RateLimitBucket {
  key     String   @id
  hits    Int
  resetAt DateTime @db.Timestamptz(3)

  @@index([resetAt])
}

// ---------------------------------------------------------------------------
// Product catalogue and persistent drafts
// ---------------------------------------------------------------------------

model Product {
  id              String   @id @default(cuid())
  sellerId        String
  name            String
  description     String?
  sku             String?
  defaultQuantity Int      @default(1)
  archivedAt      DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  seller          Seller   @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  drafts          OrderDraft[]
  orders          Order[]

  @@index([sellerId, archivedAt])
  @@index([sellerId, createdAt])
}

model OrderDraft {
  id               String    @id @default(cuid())
  sellerId         String
  productId        String
  status           String    @default("DRAFT")
  quantity         Int       @default(1)
  recipientName    String?
  recipientPhone   String?
  addressLine1     String?
  addressLine2     String?
  city             String?
  state            String?
  postalCode       String?
  courier          String?
  trackingNumber   String?
  notes            String?
  activatedOrderId String?   @unique
  archivedAt       DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  seller           Seller    @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  product          Product   @relation(fields: [productId], references: [id])
  tokens           DraftQrToken[]
  order            Order?    @relation("DraftOrder")

  @@index([sellerId, status, updatedAt])
  @@index([productId])
}

model DraftQrToken {
  id             String    @id @default(cuid())
  draftId        String
  purpose        String
  tokenHash      String    @unique
  encryptedToken String
  expiresAt      DateTime
  revokedAt      DateTime?
  createdAt      DateTime  @default(now())
  draft          OrderDraft @relation(fields: [draftId], references: [id], onDelete: Cascade)

  @@index([draftId, purpose])
}

// ---------------------------------------------------------------------------
// Orders, shipment truth and delivery verification
// ---------------------------------------------------------------------------

model Order {
  id              String         @id @default(cuid())
  sellerId        String
  sellerReference String?
  productId       String?
  draftId         String?        @unique
  itemName        String?
  itemDescription String?
  quantity        Int            @default(1)
  customerName    String
  customerPhone   String
  customerUserId  String?
  addressLine1    String
  addressLine2    String?
  city            String
  state           String
  postalCode      String
  status          String         @default("CREATED")
  deliveryAttempt Int            @default(0)
  acceptedAttempt Int?
  acceptedUntil   DateTime?
  acceptedChallengeId String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  seller          Seller         @relation(fields: [sellerId], references: [id])
  product         Product?       @relation(fields: [productId], references: [id])
  draft           OrderDraft?    @relation("DraftOrder", fields: [draftId], references: [id])
  customerUser    User?          @relation("CustomerUser", fields: [customerUserId], references: [id])
  events          OrderEvent[]
  tokens          QrToken[]
  challenges      OtpChallenge[]
  ledger          LedgerEntry[]
  shipment        Shipment?
  claims          ParcelClaim[]
  locations       LocationEvidence[]
  reservation     BudgetReservation?
  earning         DeliveryEarning?

  @@index([sellerId, status])
  @@index([sellerId, createdAt])
  @@index([customerPhone])
  @@index([customerUserId])
  @@unique([id, sellerId])
}

model OrderEvent {
  id         String   @id @default(cuid())
  orderId    String
  eventType  String
  fromStatus String?
  toStatus   String?
  actorType  String
  actorId    String?
  reasonCode String?
  note       String?
  source     String
  metadata   Json?
  createdAt  DateTime @default(now())
  order      Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId, createdAt])
  @@index([createdAt, eventType])
}

model QrToken {
  id             String    @id @default(cuid())
  orderId        String
  purpose        String
  tokenHash      String    @unique
  encryptedToken String?
  expiresAt      DateTime
  revokedAt      DateTime?
  createdAt      DateTime  @default(now())
  order          Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId, purpose])
}

model OtpChallenge {
  id                    String    @id @default(cuid())
  orderId               String
  customerTokenId       String
  recipientPhone        String?
  codeHash              String
  verificationHash      String?
  expiresAt             DateTime
  attempts              Int       @default(0)
  deliveryAttempt       Int       @default(-1)
  consumedAt            DateTime?
  verifiedAt            DateTime?
  verificationExpiresAt DateTime?
  createdAt             DateTime  @default(now())
  order                 Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([customerTokenId, createdAt])
}

model Shipment {
  id                 String          @id @default(cuid())
  orderId            String          @unique
  provider           String          @default("AFTERSHIP")
  courier            String
  trackingNumber     String
  providerShipmentId String?
  courierStatus      String          @default("PENDING")
  lastCourierEventAt DateTime?
  lastSyncedAt       DateTime?
  lastError          String?
  registeredAt       DateTime?
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt
  order              Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  events             ShipmentEvent[]

  @@index([providerShipmentId])
  @@index([courierStatus])
}

model ShipmentEvent {
  id              String   @id @default(cuid())
  shipmentId      String
  providerEventId String   @unique
  status          String
  message         String?
  occurredAt      DateTime
  receivedAt      DateTime @default(now())
  metadata        Json?
  shipment        Shipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)

  @@index([shipmentId, occurredAt])
}

model ParcelClaim {
  id              String    @id @default(cuid())
  orderId         String
  deliveryUserId  String
  status          String    @default("PENDING")
  note            String?
  rejectionReason String?
  claimedAt       DateTime  @default(now())
  decidedAt       DateTime?
  decidedBy       String?
  handoffAt       DateTime?
  order           Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  deliveryUser    User      @relation("ClaimDeliveryUser", fields: [deliveryUserId], references: [id])
  decidedByUser   User?     @relation("ClaimDecisionMaker", fields: [decidedBy], references: [id])
  locations       LocationEvidence[]

  @@index([orderId, status])
  @@index([deliveryUserId, status])
}

model LocationEvidence {
  id             String    @id @default(cuid())
  orderId        String
  deliveryUserId String?
  claimId        String?
  kind           String
  status         String
  latitude       Float?
  longitude      Float?
  accuracyMeters Float?
  capturedAt     DateTime?
  failureReason  String?
  purgeAt        DateTime
  purgedAt       DateTime?
  createdAt      DateTime  @default(now())
  order          Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  deliveryUser   User?     @relation(fields: [deliveryUserId], references: [id])
  claim          ParcelClaim? @relation(fields: [claimId], references: [id], onDelete: SetNull)

  @@index([orderId, kind, createdAt])
  @@index([purgeAt])
}

// ---------------------------------------------------------------------------
// Internal delivery reward ledger (legacy + new payable earnings)
// ---------------------------------------------------------------------------

model LedgerEntry {
  id                String   @id @default(cuid())
  sellerId          String
  orderId           String
  amountPaise       Int
  currency          String   @default("INR")
  type              String
  eligibilityReason String
  createdAt         DateTime @default(now())
  seller            Seller   @relation(fields: [sellerId], references: [id])
  order             Order    @relation(fields: [orderId, sellerId], references: [id, sellerId])

  @@unique([orderId, type])
  @@index([sellerId, createdAt])
}

model Notification {
  id        String   @id @default(cuid())
  sellerId  String
  title     String
  body      String
  createdAt DateTime @default(now())
  seller    Seller   @relation(fields: [sellerId], references: [id])

  @@index([sellerId, createdAt])
}

model AppNotification {
  id        String    @id @default(cuid())
  userId    String
  type      String
  title     String
  body      String
  orderId   String?
  readAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([userId, readAt])
}

// ---------------------------------------------------------------------------
// Seller funding, reservations, earnings and payouts
// ---------------------------------------------------------------------------

model FundingAccount {
  id              String   @id @default(cuid())
  sellerId        String   @unique
  currency        String   @default("INR")
  availablePaise  Int      @default(0)
  reservedPaise   Int      @default(0)
  refundedPaise   Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  seller          Seller   @relation(fields: [sellerId], references: [id], onDelete: Cascade)
}

model FundingTransaction {
  id               String    @id @default(cuid())
  sellerId         String
  provider         String    @default("RAZORPAY")
  providerOrderId  String?
  providerPaymentId String?  @unique
  principalPaise   Int
  feePaise         Int       @default(0)
  totalPaise       Int
  currency         String    @default("INR")
  status           String    @default("CREATED")
  refundedPaise    Int       @default(0)
  idempotencyKey   String    @unique
  failureReason    String?
  createdAt        DateTime  @default(now())
  capturedAt       DateTime?
  refundedAt       DateTime?
  seller           Seller    @relation(fields: [sellerId], references: [id], onDelete: Cascade)

  @@index([sellerId, createdAt])
  @@index([status])
}

model BudgetReservation {
  id                String    @id @default(cuid())
  sellerId          String
  orderId           String    @unique
  rewardPaise       Int       @default(500)
  feeAllowancePaise Int       @default(100)
  totalPaise        Int
  status            String    @default("RESERVED")
  createdAt         DateTime  @default(now())
  releasedAt        DateTime?
  consumedAt        DateTime?
  seller            Seller    @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  order             Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([sellerId, status])
}

model DeliveryEarning {
  id               String    @id @default(cuid())
  orderId          String    @unique
  sellerId         String
  deliveryUserId   String
  amountPaise      Int       @default(500)
  currency         String    @default("INR")
  status           String    @default("PENDING")
  availableAt      DateTime?
  payoutTransferId String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  seller           Seller    @relation(fields: [sellerId], references: [id])
  deliveryUser     User      @relation(fields: [deliveryUserId], references: [id])
  order            Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  payoutTransfer   PayoutTransfer? @relation(fields: [payoutTransferId], references: [id])

  @@index([deliveryUserId, status])
  @@index([status, availableAt])
}

model PayoutAccount {
  id                 String    @id @default(cuid())
  userId             String    @unique
  method             String
  upiId              String?
  accountName        String?
  accountNumberLast4 String?
  ifsc               String?
  providerContactId  String?
  providerFundAccountId String?
  status             String    @default("PENDING")
  verifiedAt         DateTime?
  updatedAt          DateTime  @updatedAt
  user               User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model PayoutBatch {
  id          String    @id @default(cuid())
  weekStart   DateTime  @unique
  weekEnd     DateTime
  scheduledFor DateTime
  status      String    @default("SCHEDULED")
  createdAt   DateTime  @default(now())
  processedAt DateTime?
  note        String?
  transfers   PayoutTransfer[]

  @@index([status])
}

model PayoutTransfer {
  id              String    @id @default(cuid())
  batchId         String
  deliveryUserId  String
  amountPaise     Int
  status          String    @default("PENDING")
  idempotencyKey  String    @unique
  providerPayoutId String?
  failureReason   String?
  attempts        Int       @default(0)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  processedAt     DateTime?
  batch           PayoutBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)
  earnings        DeliveryEarning[]

  @@index([deliveryUserId, status])
  @@index([status])
}

// ---------------------------------------------------------------------------
// Reliable background work and audit
// ---------------------------------------------------------------------------

model OutboxJob {
  id             String    @id @default(cuid())
  type           String
  payload        Json
  status         String    @default("PENDING")
  attempts       Int       @default(0)
  availableAt    DateTime  @default(now())
  lockedAt       DateTime?
  lastError      String?
  idempotencyKey String?   @unique
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([status, availableAt])
}

model AuditLog {
  id          String   @id @default(cuid())
  actorUserId String?
  actorRole   String
  action      String
  entityType  String
  entityId    String?
  metadata    Json?
  createdAt   DateTime @default(now())
  actor       User?    @relation(fields: [actorUserId], references: [id])

  @@index([createdAt])
  @@index([entityType, entityId])
}
