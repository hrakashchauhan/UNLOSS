# Keep /api for local development; Vite proxies it to 127.0.0.1:3001.
# For a separately hosted API, set the public HTTPS URL ending in /api.
VITE_API_BASE_URL=/api
# Optional isolated synthetic workflows on a dedicated demo deployment. False by default in production.
VITE_ENABLE_DEMO=false

# Same public client ID as GOOGLE_CLIENT_ID on the backend (not a secret).
# VITE_GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
