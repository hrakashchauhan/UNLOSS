    "@testing-library/react": "^16.3.3",
    "@types/leaflet": "^1.9.22",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "axe-core": "^4.11.1",
    "eslint": "^10.13.0",
    "jsdom": "^30.1.3",
    "jsqr": "^1.4.0",
    "typescript-eslint": "^8.72.0",
    "vitest": "^5.0.5"
